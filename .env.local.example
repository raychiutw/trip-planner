# Copy to .env.local and customize (not committed to version control)
DEV_MOCK_EMAIL=your-email@example.com
ADMIN_EMAIL=lean.lean@gmail.com

# 本機開發（vite dev）：web 的 API 請求與認證都走新 api，必須指定網址（沒有就不能登入）。
# staging 的網址：https://trip-planner-api.lean-lean.workers.dev
# 注意：新 api 的 CORS／redirect_uri 白名單要有 http://localhost:<vite 埠>，否則登入會被拒；本機沒設白名單就改用 staging 驗證。
# VITE_API_BASE_URL=https://trip-planner-api.lean-lean.workers.dev
