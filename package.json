{
  "name": "tripline",
  "version": "2.57.113",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,green \"vite\" \"wrangler pages dev dist --local --port 8788 --d1 DB\"",
    "predev": "node scripts/sync-local-d1-migrations.mjs || true",
    "dev:vite": "vite",
    "dev:staging": "concurrently -n vite,api -c cyan,yellow \"vite\" \"wrangler pages dev dist --local --port 8788 --d1 DB -b ENVIRONMENT=preview\"",
    "dev:prod": "concurrently -n vite,api -c cyan,red \"vite\" \"wrangler pages dev dist --port 8788\"",
    "dev:init": "node scripts/init-local-db.js && node scripts/sync-local-d1-migrations.mjs",
    "dev:reset": "node scripts/init-local-db.js --reset && node scripts/sync-local-d1-migrations.mjs",
    "build": "cross-env BROWSERSLIST=\"last 2 Chrome versions\" vite build && node -e \"const fs=require('fs');const p=require('path');['admin','manage'].forEach(d=>{fs.mkdirSync(p.join('dist',d),{recursive:true});fs.copyFileSync(p.join('dist','index.html'),p.join('dist',d,'index.html'))})\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p tsconfig.functions.json",
    "test": "vitest run --maxWorkers=2",
    "test:api": "vitest run --config vitest.config.api.mts",
    "test:all": "npm test && npm run test:api",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify-sw": "node scripts/verify-sw.js",
    "memory:export": "bash scripts/memory-sync.sh export",
    "memory:import": "bash scripts/memory-sync.sh import",
    "_runtime_note": "Google scripts use bun (TypeScript native, no node loader needed). Others node.",
    "backfill:google": "bun scripts/google-poi-initial-backfill.ts",
    "refresh:google": "bun scripts/google-poi-refresh-30d.ts",
    "quota:google": "bun scripts/google-quota-monitor.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"functions/**/*.ts\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@playwright/test": "^1.61.1",
    "@sentry/vite-plugin": "^11.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.12.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "miniflare": "^4.20260730.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.131.0"
  },
  "_overrides_note": "v2.33.61 round 14: pin transitive deps to patch HIGH CVE per `npm audit` 2026-05-24. Re-audit + remove if upstream releases fix.",
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "serialize-javascript": "^7.0.5",
    "fast-uri": "^3.1.2",
    "dompurify": "^3.4.17",
    "undici": "^7.29.1",
    "source-map-js": "^1.2.2",
    "miniflare": {
      "sharp": "$sharp"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@headlessui/react": "^2.2.10",
    "@sentry/react": "^11.9.0",
    "@types/google.maps": "^3.66.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "html2pdf.js": "^0.14.0",
    "idb": "^8.0.3",
    "marked": "^18.1.1",
    "nodemailer": "^10.0.12",
    "oidc-provider": "^9.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  }
}
